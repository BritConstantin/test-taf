{
  "name": "activity-ranking-acceptance",
  "version": "1.0.0",
  "private": true,
  "description": "Specification-first HTTP acceptance tests; no product implementation",
  "type": "commonjs",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:harness": "npm run build && node --test dist/test/harness.test.js",
    "validate": "npm run build && node dist/test/validate.js",
    "bdd:dry-run": "npm run build && cucumber-js --dry-run --format summary",
    "test:acceptance": "npm run build && cucumber-js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:harness && npm run validate && npm run bdd:dry-run",
    "test": "npm run test:acceptance"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
