OPEN_METEO_GEOCODING_BASE_URL=http://127.0.0.1:4400
OPEN_METEO_FORECAST_BASE_URL=http://127.0.0.1:4400
OPEN_METEO_TIMEOUT_MS=300
OPEN_METEO_RETRIES=0
APP_CACHE_ENABLED=false
APP_CLOCK_MODE=fixed
APP_FIXED_NOW=2026-10-23T23:30:00Z
